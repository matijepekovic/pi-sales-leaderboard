# Private file: ~/.config/printer-app/env (mode 0600). Never commit real secrets.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_MAILBOX=INBOX
EMAIL_SUBJECT_CONTAINS=
EMAIL_FROM_CONTAINS=
EMAIL_LOOKBACK_DAYS=3
EMAIL_POLL_SECONDS=60
PRINTER_QUEUE=konicaa
PRINTER_HOST=0.0.0.0
PRINTER_PORT=5055
PRINTER_UI_USER=admin
PRINTER_UI_PASSWORD_HASH=
PRINTER_SECRET_KEY=
PRINTER_TIMEZONE=America/Los_Angeles
PRINTER_SECURE_COOKIE=0
MAX_ATTACHMENT_MB=20
CONVERSION_TIMEOUT_SECONDS=120
PRINTER_RETRY_SECONDS=60
# Optional; default is ~/.local/share/printer-app. Re-run install after changing.
# PRINTER_DATA_DIR=/home/scoreboard/.local/share/printer-app
# LIBREOFFICE_BIN=/usr/bin/libreoffice
