# Private file: ~/.config/printer-app/env (mode 0600). Never commit real secrets.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_ENABLED=1
EMAIL_MAILBOX=INBOX
EMAIL_SUBJECT_CONTAINS=
EMAIL_FROM_CONTAINS=
EMAIL_LOOKBACK_DAYS=3
EMAIL_POLL_SECONDS=60
PRINTER_QUEUE=konicaa
PRINTER_HOST=0.0.0.0
PRINTER_PORT=5055
PRINTER_SECRET_KEY=
PRINTER_TIMEZONE=America/Los_Angeles
PRINTER_SECURE_COOKIE=0
# Legacy name: warning threshold only. Larger attachments still download and print.
MAX_ATTACHMENT_MB=20
CONVERSION_TIMEOUT_SECONDS=120
PRINTER_RETRY_SECONDS=60
# Optional; default is ~/.local/share/printer-app. Re-run install after changing.
# PRINTER_DATA_DIR=/home/scoreboard/.local/share/printer-app
# LIBREOFFICE_BIN=/usr/bin/libreoffice

# Print dialog defaults; source layout is preserved unless explicitly overridden.
PRINT_PAPER=source
PRINT_ORIENTATION=source
PRINT_COLOR=default
PRINT_SIDES=default
EXCEL_SCALE=source
EXCEL_MARGINS=source
EXCEL_SHEETS=all
EXCEL_PAGE_POLICY=one-page
PDF_SCALING=default
PRINT_COPIES=1
EXCEL_SCALE_PERCENT=100

# Email polling stays independent from print timing. Existing installs print immediately
# until a weekly schedule (or hold mode) is saved in Print Control -> Settings.
PRINT_SCHEDULE_MODE=immediate
PRINT_SCHEDULE_DAYS=mon,tue,wed,thu,fri
PRINT_SCHEDULE_TIME=09:00

# Opt in from Printer Settings -> Automatic cleanup. Updates never enable deletion.
CLEANUP_ENABLED=0
CLEANUP_DAYS=7
# Applies to ALL old messages in EMAIL_MAILBOX, ignoring sender/subject filters.
# The browser binds consent to that account/mailbox; do not edit the scope manually.
CLEANUP_EMAILS=0
CLEANUP_EMAIL_SCOPE=
