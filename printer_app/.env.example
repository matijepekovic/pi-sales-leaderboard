# Copy/configure outside the checkout: /home/scoreboard/.config/printer-app/env
# chmod 600 this file. Do not commit the real environment file.
EMAIL_USER=''
EMAIL_APP_PASSWORD=''
EMAIL_MAILBOX='INBOX'
EMAIL_SUBJECT_CONTAINS=''
EMAIL_FROM_CONTAINS=''
EMAIL_LOOKBACK_DAYS=1
EMAIL_POLL_SECONDS=60
# Warning only. Larger attachments are still downloaded and processed.
ATTACHMENT_WARN_MB=25
DISK_RESERVE_MB=128
CONVERSION_TIMEOUT_SECONDS=90
PRINTER_QUEUE='konicaa'
PRINTER_HOST='0.0.0.0'
PRINTER_PORT=5055
# Default: /home/scoreboard/.local/share/printer-app/data
# PRINTER_DATA_DIR='/home/scoreboard/.local/share/printer-app/data'
UI_USER='admin'
# Generated by python -m printer_app configure; no default password.
UI_PASSWORD_HASH=''
SESSION_SECRET=''
# Direct HTTP is for a trusted LAN only. Set 1 behind HTTPS.
COOKIE_SECURE=0
TZ='America/Los_Angeles'
