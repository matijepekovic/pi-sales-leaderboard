[Unit]
Description=Independent printer automation web UI
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=scoreboard
Group=scoreboard
WorkingDirectory=@BASE@/current
EnvironmentFile=@ENV@
Environment=PRINTER_ENV_FILE=@ENV@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash @BASE@/current/printer_app/launch.sh web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA@ @CONFIG@
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=192M
CPUQuota=50%
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=printer-app-web

[Install]
WantedBy=multi-user.target
