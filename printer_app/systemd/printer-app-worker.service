[Unit]
Description=Independent Printer Automation Gmail and Print Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=scoreboard
Group=scoreboard
WorkingDirectory=@HOME@/.local/share/printer-app/current
EnvironmentFile=@HOME@/.config/printer-app/env
ExecStart=@HOME@/.local/share/printer-app/current/.venv/bin/python -m printer_app worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.local/share/printer-app
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
Nice=10
CPUQuota=75%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=printer-app-worker

[Install]
WantedBy=multi-user.target
