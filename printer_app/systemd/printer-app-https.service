[Unit]
Description=Printer Gallery local HTTPS proxy
After=network.target printer-app-web.service
Wants=printer-app-web.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --config /etc/printer-app-https/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/printer-app-https/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
CPUQuota=25%
Nice=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=printer-app-https

[Install]
WantedBy=multi-user.target
