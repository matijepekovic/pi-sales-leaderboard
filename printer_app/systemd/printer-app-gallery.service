[Unit]
Description=Printer application gallery processing (independent of printing)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=scoreboard
Group=scoreboard
WorkingDirectory=@BASE@/current
EnvironmentFile=@ENV@
Environment=PRINTER_ENV_FILE=@ENV@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/bin/bash @BASE@/current/printer_app/launch.sh gallery
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA@
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryHigh=384M
MemoryMax=512M
CPUQuota=25%
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=printer-app-gallery

[Install]
WantedBy=multi-user.target
