[Unit]
Description=Pi Tableau Leaderboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APPDIR__/app
Environment=PYTHONUNBUFFERED=1
ExecStart=__VENV__/bin/waitress-serve --host=0.0.0.0 --port=8765 server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
